generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress      Progress[]
  proposals     ModificationProposal[]
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // e.g. "react", "javascript"
  description String?
  engine      String   @default("REACT") // e.g. "REACT", "PYTHON", "TERMINAL"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
}

model Lesson {
  id                  String   @id @default(cuid())
  topicId             String
  order               Int      @default(0)
  title               String
  concept             String
  exampleCode         String
  exerciseDescription String
  starterCode         String
  solution            String
  test                String   // Stringified function

  topic               Topic    @relation(fields: [topicId], references: [id])
  progress            Progress[]
  proposals           ModificationProposal[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([topicId, order])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model ModificationProposal {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  proposedChanges String   // JSON string of changes to lesson fields
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  lesson          Lesson   @relation(fields: [lessonId], references: [id])
}
